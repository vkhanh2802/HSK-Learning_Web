# Chạy local: SQLite trong file.
DATABASE_URL="file:./prisma/dev.db"

# --- Chỉ dùng khi deploy (xem DEPLOY.md) ---
# Có TURSO_DATABASE_URL thì web dùng Turso thay cho file SQLite ở trên.
# TURSO_DATABASE_URL="libsql://<tên-db>-<tài-khoản>.turso.io"
# TURSO_AUTH_TOKEN="<token từ: turso db tokens create <tên-db>>"

# Có APP_PASSWORD thì mọi trang yêu cầu đăng nhập. AUTH_SECRET: chuỗi ngẫu nhiên ≥ 32 ký tự,
# tạo bằng: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# APP_PASSWORD="<mật khẩu dài, khó đoán>"
# AUTH_SECRET="<chuỗi ngẫu nhiên>"

# Múi giờ tính "hôm nay" / chuỗi ngày học (mặc định Asia/Ho_Chi_Minh; máy chủ Vercel chạy giờ UTC).
# APP_TIMEZONE="Asia/Ho_Chi_Minh"
